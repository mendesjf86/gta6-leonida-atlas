# Mundo Vice: cache rules for the static map on Apache.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|.*\.html|.*\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|webp|png|svg|json)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
